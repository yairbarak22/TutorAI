{
  "name": "tutorai",
  "private": true,
  "version": "0.1.0",
  "description": "TutorAI — local-first AI study companion (Reichman University students)",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @tutorai/web",
    "build": "npm run build -w @tutorai/web",
    "preview": "npm run preview -w @tutorai/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "vitest run plugins",
    "eval:live": "TUTORAI_LIVE=1 vitest run plugins/evals.test.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run e2e",
    "fixtures": "node scripts/make-fixtures.mjs",
    "screenshots": "node scripts/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
